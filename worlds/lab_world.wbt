# ==============================================================================
# Mobile Robot: RoboMaster Mobile Research Base (agent0)
# ==============================================================================
Robot {
  translation 0 -1.7 0.045
  rotation 0 0 1 1.5708
  children [
    # Chassis Visual Body
    Pose {
      translation 0 0 0.04
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.25
            metalness 0.5
            roughness 0.3
          }
          geometry Box {
            size 0.26 0.20 0.06
          }
        }
        # LED Indicator
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.8 0.2
            emissiveColor 0.1 0.8 0.2
          }
          geometry Cylinder {
            height 0.02
            radius 0.04
          }
        }
      ]
    }
    # Left Wheel (+Y = +0.12m)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.0 0.12 0.0
      }
      device [
        RotationalMotor {
          name "left wheel motor"
          maxVelocity 25
          maxTorque 50
        }
        PositionSensor {
          name "left wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0.0 0.12 0.0
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.9
            }
            geometry Cylinder {
              height 0.03
              radius 0.045
            }
          }
        ]
        boundingObject Cylinder {
          height 0.03
          radius 0.045
        }
        physics Physics {
          density -1
          mass 0.4
        }
        name "left_wheel"
      }
    }
    # Right Wheel (-Y = -0.12m)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.0 -0.12 0.0
      }
      device [
        RotationalMotor {
          name "right wheel motor"
          maxVelocity 25
          maxTorque 50
        }
        PositionSensor {
          name "right wheel sensor"
        }
      ]
      endPoint Solid {
        translation 0.0 -0.12 0.0
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.9
            }
            geometry Cylinder {
              height 0.03
              radius 0.045
            }
          }
        ]
        boundingObject Cylinder {
          height 0.03
          radius 0.045
        }
        physics Physics {
          density -1
          mass 0.4
        }
        name "right_wheel"
      }
    }
    # Front Passive Caster Visual
    Pose {
      translation 0.10 0 -0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
          }
          geometry Sphere {
            radius 0.015
          }
        }
      ]
    }
    # Rear Passive Caster Visual
    Pose {
      translation -0.10 0 -0.03
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
          }
          geometry Sphere {
            radius 0.015
          }
        }
      ]
    }
    # Sensors
    GPS {
      name "gps"
    }
    InertialUnit {
      name "inertial_unit"
    }
  ]
  name "agent0"
  boundingObject Group {
    children [
      # Raised central chassis box (never drags on floor)
      Pose {
        translation 0 0 0.05
        children [
          Box {
            size 0.22 0.18 0.06
          }
        ]
      }
      # Front Spherical Caster Contact
      Pose {
        translation 0.10 0 -0.03
        children [
          Sphere {
            radius 0.015
          }
        ]
      }
      # Rear Spherical Caster Contact
      Pose {
        translation -0.10 0 -0.03
        children [
          Sphere {
            radius 0.015
          }
        ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 3.0
    centerOfMass [ 0 0 0.01 ]
  }
  controller "<extern>"
  supervisor TRUE
}
