#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "LLM-Assisted Mobile Robot Task Planning Laboratory Arena (ENU Coordinate System)"
    "Simulated laboratory with entrance, storage, workbench, charging station, and inspection table."
  ]
  title "Mobile Robot Task Planning Lab"
  basicTimeStep 32
  gravity 9.81
  coordinateSystem "ENU"
}

Viewpoint {
  orientation -0.57 0.57 0.58 2.09
  position 0.0 -6.5 5.5
}

TexturedBackground {
  texture "factory"
}

TexturedBackgroundLight {
  texture "factory"
  luminosity 1.2
}

# Laboratory Floor (5.2m x 5.2m, Floor surface at Z = 0)
RectangleArena {
  translation 0 0 0
  floorSize 5.2 5.2
  floorTileSize 0.5 0.5
  wallHeight 0.5
  wallThickness 0.1
  wallAppearance PBRAppearance {
    baseColor 0.85 0.88 0.92
    roughness 0.5
  }
}

# ==============================================================================
# Landmark 1: Entrance Staging Zone (0.0, -1.7) - Green
# ==============================================================================
Solid {
  translation 0 -1.7 0.002
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.8 0.3
        roughness 0.3
      }
      geometry Plane {
        size 0.8 0.8
      }
    }
  ]
  name "zone_entrance"
}

# ==============================================================================
# Landmark 2: Storage Area (-1.4, -1.2) - Yellow
