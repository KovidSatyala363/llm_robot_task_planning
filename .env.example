# ============================================================================
# LLM brain configuration for llm_robot_task_planning
#
# SETUP: copy this file to ".env" and fill in your own values:
#     cp .env.example .env
# ".env" is git-ignored and must NEVER be committed (it holds your API key).
# Shell-exported variables always override values in ".env".
# ============================================================================

# ---- Brain preference -------------------------------------------------------
# OPTION A: force ONE brain (strict, no fallback to other brains):
#   LLM_PROVIDER=qwen     -> Qwen cloud API only
#   LLM_PROVIDER=ollama   -> local Ollama only
#   LLM_PROVIDER=mock     -> smart offline rule-based planner only
#LLM_PROVIDER=qwen

# OPTION B: ordered fallback chain (used only when LLM_PROVIDER is unset).
LLM_PRIORITY=qwen,ollama,mock

# ---- Qwen (DashScope, OpenAI-compatible) ------------------------------------
# Get a key from https://dashscope.console.aliyun.com/ (starts with "sk-").
# Leave blank if you only use ollama/mock.
QWEN_API_KEY=sk-your-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.5-plus

# ---- Ollama (local, http://localhost:11434) ---------------------------------
# Requires: `ollama serve` once, then `ollama pull llama3.2`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
